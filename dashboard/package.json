{
  "name": "gauge-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "build:native": "tsc && vite build --mode native",
    "ios:add": "npm run build:native && cap add ios && node scripts/configure-ios.mjs",
    "ios:sync": "npm run build:native && cap sync ios && node scripts/configure-ios.mjs",
    "ios:open": "cap open ios",
    "test": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.2",
    "@capacitor/ios": "8.5.3",
    "@capacitor/share": "8.0.1",
    "@noble/hashes": "^2.4.0"
  }
}
