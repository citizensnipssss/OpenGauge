        "columns": 1,
        "rows": 1,
        "slots": [{"slotId": "slot-1", "x": 0, "y": 0, "w": 1, "h": 1, "sizeClass": "hero"}]
      },
      "landscape": {
        "columns": 1,
        "rows": 1,
        "slots": [{"slotId": "slot-1", "x": 0, "y": 0, "w": 1, "h": 1, "sizeClass": "hero"}]
