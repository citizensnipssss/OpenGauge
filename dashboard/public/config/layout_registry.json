{
  "schemaVersion": 1,
  "orientationBehavior": "adaptive",
  "fitPolicy": {
    "drivingLayouts": "fit-viewport",
    "diagnosticLayouts": ["fit-all", "readable-scroll"],
    "defaultDiagnosticMode": "fit-all",
    "minimumReadableSlotPx": 92,
    "slotAspectRatio": 1,
    "gapCss": "clamp(8px, 2vw, 14px)",
    "safePaddingCss": "max(10px, env(safe-area-inset-top), env(safe-area-inset-right), env(safe-area-inset-bottom), env(safe-area-inset-left))"
  },
  "geometryModel": {
    "type": "unit-grid",
    "description": "Each orientation defines a logical grid. Slot x/y/w/h are geometry only. w and h should match for square gauge tiles. Runtime computes the largest base unit that fits the usable viewport, then centers the resulting composition.",
    "baseUnitFormula": "min((usableWidth - gap*(columns-1))/columns, (usableHeight - gap*(rows-1))/rows)",
    "slotPixelWidthFormula": "w*baseUnit + (w-1)*gap",
    "slotPixelHeightFormula": "h*baseUnit + (h-1)*gap"
  },
  "layouts": [
